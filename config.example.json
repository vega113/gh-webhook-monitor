{
  "repos": {
    "owner/repo": {
      "localPath": "/path/to/local/checkout",
      "enabled": true
    }
  },
  "agent": {
    "type": "claude",
    "claude": {
      "bin": "claude",
      "model": "",
      "allowedTools": "",
      "extraArgs": "--dangerously-skip-permissions"
    }
  },
  "settings": {
    "maxConcurrentJobs": 10,
    "jobTimeoutMinutes": 20,
    "enabledEvents": {
      "pull_request_review": true,
      "check_suite": true,
      "check_run": true,
      "issues": true,
      "issue_comment": true,
      "pull_request": true
    },
    "postMergeGate": {
      "enabled": false,
      "workflowFile": ".github/workflows/build.yml",
      "workflowName": "Build",
      "checkName": "Server Build (JDK 17)",
      "branch": "main",
      "cooldownMinutes": 10,
      "triggerOnMerge": false
    },
    "agentRouter": {
      "enabled": true,
      "policy": "conservative-hybrid",
      "codexMiniModel": "gpt-5.4-mini",
      "codexFullModel": "gpt-5.4"
    }
  }
}
